# Ignite Buyer Board - Environment Variables
# Copy this file to .env and fill in real values
# .env is gitignored and must never be committed
# On Vercel: set these in Settings, Environment Variables

# ─── Anthropic ───────────────────────────────────────────
# Get from console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Asana ───────────────────────────────────────────────
# Personal Access Token from Chris Maffei's Asana account
# Generate at app.asana.com/0/my-profile-settings -> Apps -> Manage Developer Apps
# Rotate immediately if ever exposed
ASANA_PAT=

# Set to false when Asana is fully retired and PAT is revoked
ASANA_SYNC_ENABLED=true

# townsquareignite.com workspace GID (does not change)
ASANA_WORKSPACE_GID=461175262246056

# ─── MongoDB ─────────────────────────────────────────────
# Get from MongoDB Atlas -> Connect -> Connect your application
MONGODB_URI=

# ─── Microsoft SSO (MSAL) ────────────────────────────────
# Get from Stephen Alba / Lumina config
MSAL_CLIENT_ID=
MSAL_TENANT_ID=
MSAL_CLIENT_SECRET=
MSAL_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# ─── App ─────────────────────────────────────────────────
JWT_SECRET=
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
