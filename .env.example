# Ignite Buyer Board - Environment Variables
# Copy this file to .env and fill in real values
# .env is gitignored and must never be committed
# On Vercel: set these in Settings, Environment Variables

# Optional: override DNS resolvers if your local network (e.g. a phone hotspot or VPN)
# breaks the mongodb+srv SRV lookup with "querySrv ECONNREFUSED". Leave blank in prod.
DNS_SERVERS=

# TEMPORARY shared-password gate (see CLAUDE.md > Auth). Blank = gate disabled (local dev
# opens freely). Set in Vercel for the stakeholder preview. Remove when MSAL SSO lands.
ACCESS_PASSWORD=

# ─── Anthropic ───────────────────────────────────────────
# Get from console.anthropic.com. Not yet used by any code (planned: AI agents).
ANTHROPIC_API_KEY=

# ─── Asana ───────────────────────────────────────────────
# Personal Access Token from Chris Maffei's Asana account
# Generate at app.asana.com/0/my-profile-settings -> Apps -> Manage Developer Apps
# Rotate immediately if ever exposed
ASANA_PAT=

# Set to false when Asana is fully retired and PAT is revoked
ASANA_SYNC_ENABLED=true

# townsquareignite.com workspace GID (does not change)
ASANA_WORKSPACE_GID=461175262246056

# ─── MongoDB ─────────────────────────────────────────────
# Get from MongoDB Atlas -> Connect -> Connect your application
MONGODB_URI=

# ─── AWS S3 (file & image uploads) ───────────────────────
# IAM user needs s3:PutObject/GetObject/DeleteObject on the prefix.
AWS_REGION=us-east-1
S3_BUCKET=townsquareignite
S3_PREFIX=buyer-board/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Microsoft SSO (MSAL) ────────────────────────────────
# Planned, not yet used by code. Get from Stephen Alba / Lumina config.
MSAL_CLIENT_ID=
MSAL_TENANT_ID=
MSAL_CLIENT_SECRET=
MSAL_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# ─── App ─────────────────────────────────────────────────
JWT_SECRET=
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# ─── Lumina SEM API (read-only advertiser/line-item pull) ───────────────
# Token is a SERVER-ONLY secret; the browser only ever calls our own /api/lumina/*.
# LUMINA_API_ENV picks BOTH the base host and its token together, so the two can never
# drift apart. Defaults to "rel11" — while boards are still being imported/tested, reads
# should stay off production. Flip to "production" explicitly when going live; rel11 and
# production need DIFFERENT tokens.
LUMINA_API_ENV=rel11
LUMINA_API_TOKEN_REL11=
LUMINA_API_TOKEN_PROD=
# Optional override for the deep-link web host; normally follows LUMINA_API_ENV.
LUMINA_WEB_BASE=

# ─── Lumina Comments API ("push to Lumina" from a card comment) ─────────
# Separate service token from the SEM API above (different scopes: data:read:comments,
# data:write:comments). Comes from the Luminotes integration guide (LM-4131). Same
# explicit rel11/production switch as the SEM API, defaulting to rel11 for the same
# reason — an unset/misconfigured env must never post to production Lumina by accident.
LUMINA_COMMENTS_ENV=rel11
EXT_SEMTEAM_TOKEN_REL11=
EXT_SEMTEAM_TOKEN_PROD=
# Lumina username comments are attributed to (X-On-Behalf-Of-User) until per-buyer identity
# exists via MSAL SSO. Every "pushed" comment shows this as its author in Lumina.
LUMINA_COMMENTS_USER=
