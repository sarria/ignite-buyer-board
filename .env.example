# Ignite Buyer Board - Environment Variables
# Copy this file to .env and fill in real values
# .env is gitignored and must never be committed
# On Vercel: set these in Settings, Environment Variables

# ─── Anthropic ───────────────────────────────────────────
# Get from console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Asana ───────────────────────────────────────────────
# Personal Access Token from Chris Maffei's Asana account
# Generate at app.asana.com/0/my-profile-settings -> Apps -> Manage Developer Apps
# Rotate immediately if ever exposed
ASANA_PAT=

# Set to false when Asana is fully retired and PAT is revoked
ASANA_SYNC_ENABLED=true

# townsquareignite.com workspace GID (does not change)
ASANA_WORKSPACE_GID=461175262246056

# ─── MongoDB ─────────────────────────────────────────────
# Get from MongoDB Atlas -> Connect -> Connect your application
MONGODB_URI=

# Optional: override DNS resolvers if your local network (e.g. a phone hotspot
# or VPN) breaks the mongodb+srv SRV lookup with "querySrv ECONNREFUSED".
# Leave blank in production. Example: 1.1.1.1,8.8.8.8
DNS_SERVERS=

# ─── AWS S3 (file & image uploads) ───────────────────────
# IAM user scoped to s3:PutObject/GetObject (+DeleteObject later) on the prefix.
# Needed by the migration (uploads attachments) and the /api/uploads/presign endpoint.
AWS_REGION=us-east-1
S3_BUCKET=townsquareignite
S3_PREFIX=buyer-board/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Microsoft SSO (MSAL) ────────────────────────────────
# Get from Stephen Alba / Lumina config
MSAL_CLIENT_ID=
MSAL_TENANT_ID=
MSAL_CLIENT_SECRET=
MSAL_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# ─── TEMPORARY access gate ───────────────────────────────
# Stop-gap shared password to protect real imported data during demos, until
# MSAL SSO is built. If SET, every /api request must send it and the frontend
# shows a lock screen. Leave BLANK locally to disable the gate (app opens freely).
# Set it in Vercel for the stakeholder preview. Remove when SSO lands.
ACCESS_PASSWORD=

# ─── App ─────────────────────────────────────────────────
JWT_SECRET=
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173
